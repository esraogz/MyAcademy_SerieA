
@{
    Layout = null;
}

@{
    Layout = null; // Ana layout'a bağlı kalmadan tam ekran şık görünüm için
    ViewData["Title"] = "403 - Yetkisiz Erişim";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Serie A Yönetim Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #060b19;
            --bg-card: rgba(15, 23, 42, 0.72);
            --accent-blue: #0066ff;
            --accent-cyan: #00d2ff;
            --accent-red: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-glass: rgba(255, 255, 255, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-dark);
            background-image: radial-gradient(circle at 15% 20%, rgba(0, 102, 255, 0.18) 0%, transparent 40%), radial-gradient(circle at 85% 80%, rgba(239, 68, 68, 0.14) 0%, transparent 40%), linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: var(--text-main);
            overflow: hidden;
        }

        .container {
            position: relative;
            width: 100%;
            max-width: 540px;
            background: var(--bg-card);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-glass);
            border-radius: 28px;
            padding: 48px 40px;
            text-align: center;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            animation: cardEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .shield-wrapper {
            position: relative;
            width: 88px;
            height: 88px;
            margin: 0 auto 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 24px;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.05));
            border: 1px solid rgba(239, 68, 68, 0.35);
            box-shadow: 0 0 35px rgba(239, 68, 68, 0.25);
        }

            .shield-wrapper svg {
                width: 42px;
                height: 42px;
                color: #f87171;
                animation: pulseLock 2.5s infinite ease-in-out;
            }

        @@keyframes pulseLock {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.07);
            }
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.28);
            color: #fca5a5;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--accent-red);
            box-shadow: 0 0 8px var(--accent-red);
        }

        .error-code {
            font-size: 72px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.04em;
            background: linear-gradient(135deg, #ffffff 30%, #64748b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 12px;
            letter-spacing: -0.02em;
        }

        p {
            font-size: 15px;
            line-height: 1.65;
            color: var(--text-muted);
            margin-bottom: 32px;
        }

        .info-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-glass);
            border-radius: 14px;
            padding: 14px 18px;
            margin-bottom: 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            color: var(--text-muted);
        }

            .info-box span strong {
                color: #e2e8f0;
                font-weight: 600;
            }

        .actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-blue), #0052cc);
            color: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(0, 102, 255, 0.45);
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 30px -5px rgba(0, 102, 255, 0.65);
                filter: brightness(1.08);
            }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--border-glass);
        }

            .btn-secondary:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }

        @@media (max-width: 480px) {
            .container {
                padding: 36px 24px;
            }

            .error-code {
                font-size: 56px;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="shield-wrapper">
            <!-- Kilit / Kalkan İkonu -->
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
        </div>

        <div class="status-badge">
            <span class="status-dot"></span>
            Erişim Engellendi
        </div>

        <div class="error-code">403</div>
        <h1>Bu Sayfaya Erişim Yetkiniz Yok</h1>
        <p>
            Görüntülemeye çalıştığınız alan yalnızca yetkili yöneticilere özeldir.
            Mevcut oturumunuz bu işlem için gerekli role sahip değil veya token süreniz dolmuş olabilir.
        </p>

        <div class="info-box">
            <span>Durum Kodu: <strong>HTTP 403 Forbidden</strong></span>
            <span>Güvenlik: <strong>JWT / Role Guard</strong></span>
        </div>

        <div class="actions">
            <a href="/Admin/Auth/Login" class="btn btn-primary">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                </svg>
                Farklı Hesapla Giriş Yap
            </a>
            <a href="javascript:history.back()" class="btn btn-secondary">
                ← Önceki Sayfaya Dön
            </a>
        </div>
    </div>
</body>
</html>
